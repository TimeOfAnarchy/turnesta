# Local development values only. Never use these credentials in production.
# Existing PostgreSQL initialization credentials remain the bootstrap login.
# Changing POSTGRES_PASSWORD does not change an already initialized volume.
POSTGRES_DB=turnesta
POSTGRES_USER=turnesta
POSTGRES_PASSWORD=turnesta_local_dev

# Idempotent db-bootstrap creates/updates these separate local login passwords.
# Group roles turnesta_runtime / turnesta_provisioner cannot log in.
# Compose embeds these local passwords directly in URLs: use only URI-unreserved
# characters (letters, digits, -, ., _, ~) for these local development values.
TURNESTA_API_DB_PASSWORD=turnesta_api_local_dev
TURNESTA_ADMIN_DB_PASSWORD=turnesta_admin_local_dev
TURNESTA_MIGRATOR_DB_PASSWORD=turnesta_migrator_local_dev
TURNESTA_WORKER_DB_PASSWORD=turnesta_worker_local_dev
# Generated by scripts/Initialize-Development.ps1 into ignored .env.
# API/migrator never receive this key. Required only for enqueue/delivery.
TURNESTA_DELIVERY_KEY=

# Native host tools connect to the isolated development port.
# Compose constructs its own URL with the db service hostname and port 5432.
# Native URLs must percent-encode reserved characters in credentials.
DATABASE_URL=postgresql://turnesta_api:turnesta_api_local_dev@127.0.0.1:54329/turnesta
# For native migration / trusted operator CLI, explicitly replace DATABASE_URL
# for that process. Compose migrator / admin services choose the correct login.
MIGRATOR_DATABASE_URL=postgresql://turnesta_migrator:turnesta_migrator_local_dev@127.0.0.1:54329/turnesta
ADMIN_DATABASE_URL=postgresql://turnesta_admin:turnesta_admin_local_dev@127.0.0.1:54329/turnesta
WORKER_DATABASE_URL=postgresql://turnesta_worker:turnesta_worker_local_dev@127.0.0.1:54329/turnesta

# Native host binding. Compose always binds 0.0.0.0 inside the API container;
# the published host port remains restricted to 127.0.0.1.
TURNESTA_BIND_ADDR=127.0.0.1:8080
TURNESTA_DB_MAX_CONNECTIONS=10
TURNESTA_DB_ACQUIRE_TIMEOUT_MS=3000
TURNESTA_READY_TIMEOUT_MS=1000
TURNESTA_SHUTDOWN_TIMEOUT_MS=10000
TURNESTA_PUBLIC_ORIGIN=http://127.0.0.1:8080
TURNESTA_SESSION_TTL_SECONDS=28800
# If increasing shutdown timeout, also increase Compose stop_grace_period.
RUST_LOG=turnesta_api=info,tower_http=info,sqlx=warn

# Existing local MailHog, attached to turnesta_default with the alias mailhog.
# MailHog captures delivery locally; its web inbox is http://127.0.0.1:8025.
# SMTP settings are passed only to the delivery worker service.
TURNESTA_SMTP_HOST=mailhog
TURNESTA_SMTP_PORT=1025
TURNESTA_SMTP_FROM=no-reply@turnesta.test
TURNESTA_SMTP_TLS_MODE=insecure
TURNESTA_SMTP_ALLOW_INSECURE=true
TURNESTA_SMTP_USERNAME=
TURNESTA_SMTP_PASSWORD=
# External SMTP: use smtps (typically 465) or required starttls (typically 587),
# set ALLOW_INSECURE=false and configure username/password together when needed.
