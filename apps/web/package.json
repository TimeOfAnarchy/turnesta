{
  "name": "@turnesta/web",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": ["tools/openapi"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "api:snapshot": "node tools/openapi/snapshot.mjs",
    "api:types": "npm run generate --workspace @turnesta/openapi --",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "npm --prefix tools/lint run lint --",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
